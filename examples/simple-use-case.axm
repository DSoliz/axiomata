// Every stmt is global by default

// stmt:[]type [id] [string value]
stmt:decision a1 "we will only serve @fast-restaurant food"
stmt:decision a2 "because of @a1 the website needs an order-ahead feature"
stmt:unknown u2 "should the @fast-restaurant model apply to catering orders too"

// Statements can also be written value-first. When you type a `"` the LSP
// generates a unique id and scaffolds the stmt keyword for you.
"delivery is handled by a third party" df131 stmt:decision

// You can then type : after stmt to pick a type from the list.
"all menu items must be available within 10 minutes" df132 stmt:unknown
