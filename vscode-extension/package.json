{
  "name": "axiomata-vscode",
  "displayName": "Axiomata",
  "description": "Language support for .axm knowledge base files",
  "version": "0.1.0",
  "publisher": "axiomata",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "axm",
        "aliases": ["Axiomata", "axm"],
        "extensions": [".axm"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axm",
        "scopeName": "source.axm",
        "path": "./syntaxes/axm.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0"
  }
}
