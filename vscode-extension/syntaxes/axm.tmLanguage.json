{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Axiomata",
  "scopeName": "source.axm",
  "patterns": [
    { "include": "#comment" },
    { "include": "#type-declaration" },
    { "include": "#stmt-keyword" },
    { "include": "#string" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.axm"
    },
    "type-declaration": {
      "match": "^\\s*(type)\\s+([a-zA-Z][a-zA-Z0-9-]*)",
      "captures": {
        "1": { "name": "keyword.other.axm" },
        "2": { "name": "entity.name.type.axm" }
      }
    },
    "stmt-keyword": {
      "match": "\\bstmt(?::([a-zA-Z][a-zA-Z0-9-]*))?",
      "name": "keyword.other.axm",
      "captures": {
        "1": { "name": "entity.name.type.axm" }
      }
    },
    "string": {
      "name": "string.quoted.double.axm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "@[a-zA-Z][a-zA-Z0-9-]*",
          "name": "variable.other.reference.axm"
        },
        {
          "match": "\\\\.",
          "name": "constant.character.escape.axm"
        }
      ]
    }
  }
}
